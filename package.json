{
	"name": "wayfarer.quest",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit && vite build",
		"check": "vp check --no-fmt && tsc --noEmit && eslint . && lasertag check",
		"dev": "concurrently -k -n server,vite \"pnpm dev:server\" \"pnpm dev:vite\"",
		"dev:server": "node --env-file-if-exists=.env --watch-path=server --watch-path=src/game --watch-path=src/ai server/main.node.ts",
		"dev:vite": "vite",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"lint": "vp lint && eslint . && lasertag check",
		"preview": "vite preview",
		"record:ai-game": "node --env-file-if-exists=.env scripts/record-ai-game.node.ts",
		"spellcheck": "cspell .",
		"start": "node --env-file-if-exists=.env server/main.node.ts",
		"test": "vp test --run",
		"test:debug": "LOG_LEVEL=debug TEST_LOG_LEVEL=debug vp test --run --disableConsoleIntercept",
		"test:e2e": "vp test --run src/ai/ai-game.e2e.test.ts",
		"test:e2e:debug": "LOG_LEVEL=debug TEST_LOG_LEVEL=debug vp test --run --disableConsoleIntercept src/ai/ai-game.e2e.test.ts"
	},
	"dependencies": {
		"@ai-sdk/openai": "3.0.64",
		"ai": "6.0.185",
		"arktype": "2.2.0",
		"atom.io": "0.50.1",
		"preact": "10.29.7",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"socket.io": "4.8.3",
		"socket.io-client": "4.8.3",
		"varmint": "0.5.13"
	},
	"devDependencies": {
		"@dprint/json": "0.23.0",
		"@dprint/markdown": "0.22.1",
		"@dprint/oxc": "0.30.0",
		"@dprint/toml": "0.7.0",
		"@preact/preset-vite": "2.10.5",
		"@testing-library/react": "16.3.2",
		"@types/node": "26.1.1",
		"@types/react": "18.3.28",
		"@types/react-dom": "18.3.7",
		"@typescript-eslint/parser": "8.65.0",
		"@typescript-eslint/utils": "8.65.0",
		"concurrently": "10.0.3",
		"cspell": "10.0.1",
		"dprint": "0.55.2",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-yaml": "0.6.0",
		"eslint": "10.7.0",
		"happy-dom": "20.11.1",
		"jiti": "2.7.0",
		"lasertag": "0.6.7",
		"typescript": "7.0.2",
		"vite": "8.1.4",
		"vite-plus": "0.2.5",
		"vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
	},
	"engines": {
		"node": "26.5.0",
		"pnpm": "11.15.1"
	},
	"packageManager": "pnpm@11.15.1"
}
